{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zen Multiverse",
  "version": "0.2.24",
  "identifier": "io.thinkcore.zenmultiverse",
  "build": {
    "beforeDevCommand": "node scripts/copy-dist.mjs",
    "beforeBuildCommand": "node scripts/copy-dist.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zen Multiverse",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ThinkCore",
    "copyright": "Copyright © 2026 ThinkCore",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5NTFDMTIzRTg3RDk2QjcKUldTM2xuM29JOEZSNlU5ajBtRTEySnhFMUw3VXJ2NlhwcTJMN2MrT1BPbXBDMUFubW9PNzdrNWsK",
      "endpoints": [
        "https://github.com/dpztxzx9nf-lab/zen-multiverse/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "zenmultiverse"
        ]
      }
    }
  }
}
